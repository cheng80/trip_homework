{
  "name": "trip_homework",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test app/api/graphql/*.test.mjs components/mypage/*.test.mjs domain/*.test.mjs graphql/*.test.mjs services/*.test.mjs",
    "api:graphql:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-graphql-operations.mjs",
    "docs:graphql": "node scripts/generate-graphql-docs.mjs",
    "docs:graphql:check": "node scripts/generate-graphql-docs.mjs --check",
    "docs:graphql:serve": "python3 -m http.server 4400 --directory public/graphql-docs"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "next": "16.3.2",
    "quill": "2.0.2",
    "react": "19.2.8",
    "react-daum-postcode": "^4.0.0",
    "react-dom": "19.2.8",
    "react-quill-new": "3.7.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "graphql": "^16.14.2",
    "spectaql": "^3.0.9",
    "typescript": "^5"
  },
  "overrides": {
    "spectaql": {
      "grunt-sass": "4.1.0"
    }
  }
}
